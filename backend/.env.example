# OpenAI API key for book analysis (GPT-3.5-turbo)
OPENAI_API_KEY=sk-your-openai-key-here

# GeminiGen.ai API key for image generation
GEMINIGEN_API_KEY=your-geminigen-key-here

# GeminiGen webhook secret (optional, for webhook verification)
GEMINIGEN_WEBHOOK_SECRET=

# Reference image search providers (each key enables that provider; more keys = more engines active)
# Unsplash: Access Key from https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# SerpAPI: key from https://serpapi.com/ (used by SerpAPI, DeviantArt, Behance, Dribbble providers)
SERPAPI_KEY=
# Legacy / alternative name
SEARCH_API_KEY=

# Pexels: API key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay: API key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Openverse: optional. Without it, anonymous requests get 401 after ~5 req/hour.
# Option A (recommended): set client_id and client_secret — token will auto-refresh every ~9 h.
#   Register app: POST https://api.openverse.org/v1/auth_tokens/register/
#   Then confirm email. Run scripts/openverse_register.py to register and get credentials.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Option B: set only access token (no auto-refresh; valid ~10 h, then update manually).
OPENVERSE_ACCESS_TOKEN=

# Wikimedia Commons: no key; User-Agent is set in code. DeviantArt uses SERPAPI_KEY above.

# Database URL (default: SQLite)
DATABASE_URL=sqlite:///./app.db
